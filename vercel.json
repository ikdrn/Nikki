{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/build",
  "functions": {
    "api/nikki.go": {
      "runtime": "go1.22.x"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/nikki.go"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
